@prefix hiot:  <https://w3id.org/homeiot/ontology#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

################################################################################
# Home IoT Device Ontology
#
# Formalizes the scope definition in docs/home_iot_security_report.tex
# (sec:method-scope) and CLAUDE.md "Definition of a Home IoT Device".
#
# HAND-MAINTAINED. Regenerate the derived CSVs with:
#     python3 scripts/ontology_build.py --check    (verify, no writes)
#     python3 scripts/ontology_build.py --write    (emit categories.csv + families.csv)
#
# Two invariants (see docs/plans/PLAN_ontology.md):
#   1. data/categories.csv must regenerate BYTE-IDENTICALLY, row order included.
#      hiot:sortOrder carries that order; do not renumber casually.
#   2. skos:scopeNote text is MOVED here verbatim from the old hand-authored
#      categories.csv, never synthesized. It reaches AI reviewers through
#      gemini_classify.py, so editing it changes reviewer behaviour.
################################################################################

<https://w3id.org/homeiot/ontology> a owl:Ontology ;
  dcterms:title "Home IoT Device Ontology" ;
  dcterms:description "Device-type ontology for the residential IoT vulnerability study: five definitional criteria as class axioms over a closed facet vocabulary, 24 analysis categories in 7 families, plus 3 defined-but-excluded types." ;
  owl:versionInfo "0.1.0" .

################################################################################
# Facet properties
################################################################################

hiot:hasConnectivity a owl:ObjectProperty ;
  rdfs:label "has connectivity" ; rdfs:comment "Criterion 1." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Protocol .
hiot:hasDeviceClass a owl:ObjectProperty ;
  rdfs:label "has device class" ; rdfs:comment "Criterion 2." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:DeviceClass .
hiot:hasDeployment a owl:ObjectProperty ;
  rdfs:label "has deployment context" ; rdfs:comment "Criterion 3." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:DeploymentContext .
hiot:hasFunction a owl:ObjectProperty ;
  rdfs:label "has function" ; rdfs:comment "Criterion 4(a)." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Function .
hiot:hasRole a owl:ObjectProperty ;
  rdfs:label "has role" ; rdfs:comment "Criterion 4(b) — the home-control-surface disjunct." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Role .
hiot:hasSecurityContext a owl:ObjectProperty ;
  rdfs:label "has security context" ; rdfs:comment "Criterion 5." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:SecurityContext .

# Analysis facets — carried for RQ1/RQ2, NO bearing on membership.
hiot:formFactor a owl:ObjectProperty ; rdfs:label "form factor" ;
  rdfs:comment "Worn is what excludes wrist wearables from the sleeptracker category." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:FormFactor .
hiot:placement a owl:ObjectProperty ; rdfs:label "placement" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Placement .
hiot:actuatesPhysical a owl:DatatypeProperty ; rdfs:label "actuates physical" ;
  rdfs:comment "True when compromise can produce a physical-world consequence (unlock a door, energize a circuit, heat an element). CVSS impact metrics do not capture this; RQ2 uses it." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .
hiot:capturesAV a owl:DatatypeProperty ; rdfs:label "captures audio/video" ;
  rdfs:comment "True when the device has a camera or always-listening microphone. Privacy-relevant grouping for RQ1 Information Leak." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .

hiot:slug a owl:DatatypeProperty ; rdfs:label "slug" ;
  rdfs:comment "Pipeline identifier. Primary key of data/categories.csv and of judgment_store.csv (category, cve_id)." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .
hiot:sortOrder a owl:DatatypeProperty ; rdfs:label "sort order" ;
  rdfs:comment "Row order in the generated categories.csv. cwe888_analysis.py reads that order into cat_order and uses it for table row ordering." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:integer .
hiot:provisional a owl:DatatypeProperty ; rdfs:label "provisional" ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .
hiot:openScopeCall a owl:DatatypeProperty ; rdfs:label "open scope call" ;
  rdfs:comment "An unsettled boundary question. Must be empty before the reasoner validation in Phase 3 is considered binding." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .
hiot:failsCriteria a owl:DatatypeProperty ; rdfs:label "fails criteria" ;
  rdfs:comment "Which definitional criteria an excluded type fails, as published in the paper." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .

################################################################################
# Facet value vocabularies (closed)
################################################################################

hiot:Protocol a owl:Class .
hiot:DeviceClass a owl:Class .
hiot:DeploymentContext a owl:Class .
hiot:Function a owl:Class .
hiot:Role a owl:Class .
hiot:SecurityContext a owl:Class .
hiot:FormFactor a owl:Class .
hiot:Placement a owl:Class .

hiot:wifi a hiot:Protocol . hiot:ethernet a hiot:Protocol . hiot:zigbee a hiot:Protocol .
hiot:zwave a hiot:Protocol . hiot:thread a hiot:Protocol . hiot:matter a hiot:Protocol .
hiot:ble a hiot:Protocol . hiot:mqtt a hiot:Protocol . hiot:coap a hiot:Protocol .
hiot:cellular a hiot:Protocol . hiot:rtsp a hiot:Protocol . hiot:onvif a hiot:Protocol .

hiot:EmbeddedSensor a hiot:DeviceClass . hiot:EmbeddedAppliance a hiot:DeviceClass .
hiot:EmbeddedController a hiot:DeviceClass . hiot:GeneralPurposeCompute a hiot:DeviceClass .

hiot:Residential a hiot:DeploymentContext . hiot:Prosumer a hiot:DeploymentContext .
hiot:Commercial a hiot:DeploymentContext . hiot:Industrial a hiot:DeploymentContext .

hiot:Monitor a hiot:Function . hiot:Automate a hiot:Function . hiot:Control a hiot:Function .
hiot:MediaPlayback a hiot:Function . hiot:Transport a hiot:Function .

hiot:HomeControlSurface a hiot:Role .

hiot:ConsumerManaged a hiot:SecurityContext . hiot:ProfessionallyAdministered a hiot:SecurityContext .

hiot:Fixed a hiot:FormFactor . hiot:Portable a hiot:FormFactor . hiot:Worn a hiot:FormFactor .
hiot:Indoor a hiot:Placement . hiot:Outdoor a hiot:Placement . hiot:Either a hiot:Placement .

################################################################################
# The five criteria as an OWL equivalence axiom
#
# A device type is in scope iff it satisfies ALL five. Criterion 4 is the
# disjunction: a home-control FUNCTION (4a) OR the home-control-surface ROLE (4b).
# This is what admits streaming/smartspeakers (function is MediaPlayback, role is
# HomeControlSurface) while excluding game consoles (same function, no role, and
# GeneralPurposeCompute already fails criterion 2).
################################################################################

hiot:DeviceType a owl:Class ; rdfs:label "device type" .

# NOTE ON PUNNING. Each of the 27 device types is declared BOTH as an owl:Class
# (so families can subclass it and the taxonomy is a real hierarchy) AND as an
# individual of hiot:DeviceType (so the criteria axiom below can classify it).
# Facet values are individuals, so value groupings use owl:oneOf, not owl:unionOf
# — union is over classes, and using it over individuals would silently produce
# an axiom no reasoner acts on.

hiot:SpecialPurposeEmbedded a owl:Class ;
  rdfs:label "special-purpose embedded" ;
  owl:equivalentClass [ a owl:Class ;
    owl:oneOf (hiot:EmbeddedSensor hiot:EmbeddedAppliance hiot:EmbeddedController) ] .

hiot:GeneralPurposeComputeClass a owl:Class ;
  rdfs:label "general-purpose compute" ;
  owl:equivalentClass [ a owl:Class ; owl:oneOf (hiot:GeneralPurposeCompute) ] ;
  owl:disjointWith hiot:SpecialPurposeEmbedded .

hiot:HomeControlFunction a owl:Class ;
  rdfs:label "home-control function" ;
  owl:equivalentClass [ a owl:Class ;
    owl:oneOf (hiot:Monitor hiot:Automate hiot:Control) ] .

hiot:InScopeDeviceType a owl:Class ;
  rdfs:label "in-scope home IoT device type" ;
  owl:equivalentClass [
    a owl:Class ; owl:intersectionOf (
      hiot:DeviceType
      [ a owl:Restriction ; owl:onProperty hiot:hasConnectivity ; owl:someValuesFrom hiot:Protocol ]
      [ a owl:Restriction ; owl:onProperty hiot:hasDeviceClass ; owl:someValuesFrom hiot:SpecialPurposeEmbedded ]
      [ a owl:Restriction ; owl:onProperty hiot:hasDeployment ; owl:hasValue hiot:Residential ]
      [ a owl:Class ; owl:unionOf (
          [ a owl:Restriction ; owl:onProperty hiot:hasFunction ; owl:someValuesFrom hiot:HomeControlFunction ]
          [ a owl:Restriction ; owl:onProperty hiot:hasRole ; owl:hasValue hiot:HomeControlSurface ] ) ]
      [ a owl:Restriction ; owl:onProperty hiot:hasSecurityContext ; owl:hasValue hiot:ConsumerManaged ]
    ) ] .

hiot:ExcludedDeviceType a owl:Class ;
  rdfs:label "defined but excluded device type" ;
  rdfs:comment "Satisfies connectivity but fails the class and/or function criteria. Defined so the boundary is stated rather than implied; kept out of the analysis set." .

################################################################################
# Families
################################################################################

hiot:SecurityAccessDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Security & Access" ;
  hiot:familyId "SecurityAccess" ;
  rdfs:comment """Devices whose primary function is monitoring or controlling access to and activity within the home. Grouped on shared primary function and heavily overlapping brand sets (the sensors brand list overlaps alarms by design).""" .

hiot:ControlSurfaceDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Media & Control Surfaces" ;
  hiot:familyId "ControlSurface" ;
  rdfs:comment """Devices admitted under criterion 4(b): their qualifying function is acting as a control surface for OTHER home IoT devices, not controlling the home environment directly.""" .

hiot:ClimateAirDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Climate & Air" ;
  hiot:familyId "ClimateAir" ;
  rdfs:comment """Devices that monitor or regulate the home's thermal and air environment.""" .

hiot:EnergyDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Energy" ;
  hiot:familyId "Energy" ;
  rdfs:comment """Devices that generate, store, meter, or switch household electrical power.""" .

hiot:DomesticChoresDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Domestic & Chores" ;
  hiot:familyId "DomesticChores" ;
  rdfs:comment """Appliances that perform or automate household tasks.""" .

hiot:FixtureDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Fixtures" ;
  hiot:familyId "Fixture" ;
  rdfs:comment """Building-integrated fixtures actuated as part of the home's fabric.""" .

hiot:WellnessDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Wellness" ;
  hiot:familyId "Wellness" ;
  rdfs:comment """Non-wearable residential health and wellness monitors. PROVISIONAL — single member pending rebuild.""" .

################################################################################
# Analysis categories (24) — order is hiot:sortOrder, mirroring categories.csv
################################################################################

hiot:doorlock a owl:Class, hiot:DeviceType ;
  rdfs:subClassOf hiot:SecurityAccessDevice ;
  hiot:slug "doorlock" ;
  rdfs:label "smart lock" ;
  hiot:sortOrder 0 ;
  hiot:hasConnectivity hiot:ble, hiot:zigbee, hiot:zwave, hiot:wifi, hiot:thread, hiot:matter ;
  hiot:hasDeviceClass hiot:EmbeddedController ;
  hiot:hasDeployment hiot:Residential ;
  hiot:hasFunction hiot:Control, hiot:Automate ;
  hiot:hasSecurityContext hiot:ConsumerManaged ;
  hiot:formFactor hiot:Fixed ;
  hiot:placement hiot:Indoor ;
  hiot:actuatesPhysical true ;
  hiot:capturesAV false ;
  skos:scopeNote """IN: residential smart locks and garage-door openers (Yale, August, Tinxy, SGUDA, Genie Aladdin, Zigbee lock stacks). OUT: commercial/enterprise access-control panels and building door controllers.""" .

hiot:smartspeakers a owl:Class, hiot:DeviceType ;
  rdfs:subClassOf hiot:ControlSurfaceDevice ;
  hiot:slug "smartspeakers" ;
  rdfs:label "smart speaker" ;
  hiot:sortOrder 1 ;
  hiot:hasConnectivity hiot:wifi, hiot:ble, hiot:thread, hiot:matter ;
  hiot:hasDeviceClass hiot:EmbeddedController ;
  hiot:hasDeployment hiot:Residential ;
  hiot:hasFunction hiot:MediaPlayback ;
  hiot:hasRole hiot:HomeControlSurface ;
  hiot:hasSecurityContext hiot:ConsumerManaged ;
  hiot:formFactor hiot:Fixed ;
  hiot:placement hiot:Indoor ;
  hiot:actuatesPhysical false ;
  hiot:capturesAV true ;
  hiot:openScopeCall """Whether smart displays split out into their own category is unconfirmed; currently merged here.""" ;
  skos:scopeNote """IN: consumer smart speakers, smart displays, and smart soundbars (Echo, Nest, HomePod) — qualify as home-control surfaces via criterion 4(b). OUT: plain Bluetooth speakers, headphones, and AV receivers with no assistant/home-control role.""" .

hiot:sleeptracker a owl:Class, hiot:DeviceType ;
  rdfs:subClassOf hiot:WellnessDevice ;
  hiot:slug "sleeptracker" ;
  rdfs:label "sleep tracker" ;
  hiot:sortOrder 2 ;
  hiot:hasConnectivity hiot:wifi, hiot:ble ;
  hiot:hasDeviceClass hiot:EmbeddedSensor ;
  hiot:hasDeployment hiot:Residential ;
  hiot:hasFunction hiot:Monitor ;
  hiot:hasSecurityContext hiot:ConsumerManaged ;
  hiot:formFactor hiot:Fixed ;
  hiot:placement hiot:Indoor ;
  hiot:actuatesPhysical false ;
  hiot:capturesAV false ;
  hiot:provisional true ;
  rdfs:comment """~88% of the current set is wrist wearables (out by criterion 3) with essentially no bedside monitors. Category pending rebuild and may be dropped; the Wellness family goes with it if so.""" ;
  skos:scopeNote """IN: bedside / non-wearable sleep monitors. OUT: wrist wearables and fitness trackers (Fitbit, Apple Watch, Garmin).""" .

hiot:doorbell a owl:Class, hiot:DeviceType ;
  rdfs:subClassOf hiot:SecurityAccessDevice ;
  hiot:slug "doorbell" ;
  rdfs:label "video doorbell" ;
  hiot:sortOrder 3 ;
  hiot:hasConnectivity hiot:wifi, hiot:ethernet ;
