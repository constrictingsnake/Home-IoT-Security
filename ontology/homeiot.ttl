  hiot:hasSecurityContext hiot:ConsumerManaged ;
  hiot:formFactor hiot:Fixed ;
  hiot:placement hiot:Indoor ;
  hiot:actuatesPhysical false ;
  hiot:capturesAV false ;
  skos:scopeNote """IN: IoT hubs, bridges, and Matter/Thread/Zigbee/Z-Wave controllers (SmartThings, Hubitat, Hue Bridge). OUT: plain routers, modems, ONT, and unmanaged switches — transport, not home control.""" .

hiot:ev_charging a owl:Class, hiot:DeviceType ;
  rdfs:subClassOf hiot:EnergyDevice ;
  hiot:slug "ev-charging" ;
  rdfs:label "EV home charger" ;
