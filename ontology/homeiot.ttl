@prefix hiot:  <https://w3id.org/homeiot/ontology#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

################################################################################
# Home IoT Device Ontology
#
# Formalizes the scope definition in docs/home_iot_security_report.tex
# (sec:method-scope) and CLAUDE.md "Definition of a Home IoT Device".
#
# HAND-MAINTAINED. Regenerate the derived CSVs with:
#     python3 scripts/ontology_build.py --check    (verify, no writes)
#     python3 scripts/ontology_build.py --write    (emit categories.csv + families.csv)
#
# Two invariants (see docs/plans/PLAN_ontology.md):
#   1. data/categories.csv must regenerate BYTE-IDENTICALLY, row order included.
#      hiot:sortOrder carries that order; do not renumber casually.
#   2. skos:scopeNote text is MOVED here verbatim from the old hand-authored
#      categories.csv, never synthesized. It reaches AI reviewers through
#      gemini_classify.py, so editing it changes reviewer behaviour.
################################################################################

<https://w3id.org/homeiot/ontology> a owl:Ontology ;
  dcterms:title "Home IoT Device Ontology" ;
  dcterms:description "Device-type ontology for the residential IoT vulnerability study: five definitional criteria as class axioms over a closed facet vocabulary, plus descriptive sub-facets for analysis. 24 analysis categories in 13 folding families, plus defined-but-excluded types including one single-criterion boundary case per criterion." ;
  owl:versionInfo "0.1.0" .

################################################################################
# Facet properties
################################################################################

hiot:hasConnectivity a owl:ObjectProperty ;
  rdfs:label "has connectivity" ; rdfs:comment "Criterion 1." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Protocol .
hiot:hasDeviceClass a owl:ObjectProperty ;
  rdfs:label "has device class" ; rdfs:comment "Criterion 2." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:DeviceClass .
hiot:hasDeployment a owl:ObjectProperty ;
  rdfs:label "has deployment context" ; rdfs:comment "Criterion 3." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:DeploymentContext .
hiot:hasFunction a owl:ObjectProperty ;
  rdfs:label "has function" ; rdfs:comment "Criterion 4(a)." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Function .
hiot:hasRole a owl:ObjectProperty ;
  rdfs:label "has role" ; rdfs:comment "Criterion 4(b) — the home-control-surface disjunct." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Role .
hiot:hasSecurityContext a owl:ObjectProperty ;
  rdfs:label "has security context" ; rdfs:comment "Criterion 5." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:SecurityContext .

# Analysis facets — carried for RQ1/RQ2, NO bearing on membership.
hiot:formFactor a owl:ObjectProperty ; rdfs:label "form factor" ;
  rdfs:comment "Worn is what excludes wrist wearables from the sleeptracker category." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:FormFactor .
hiot:placement a owl:ObjectProperty ; rdfs:label "placement" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Placement .
hiot:actuatesPhysical a owl:DatatypeProperty ; rdfs:label "actuates physical" ;
  rdfs:comment "True when compromise can produce a physical-world consequence (unlock a door, energize a circuit, heat an element). CVSS impact metrics do not capture this; RQ2 uses it." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .
hiot:capturesAV a owl:DatatypeProperty ; rdfs:label "captures audio/video" ;
  rdfs:comment "True when the device has a camera or always-listening microphone. Privacy-relevant grouping for RQ1 Information Leak." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .

################################################################################
# Descriptive sub-facets (the criterion refinement)
#
# Every property below is an ANALYSIS facet: none appears in the
# hiot:InScopeDeviceType equivalence axiom, so none can move a published in/out
# ruling. They exist because the five criteria as originally encoded are too
# coarse to support analysis:
#
#   - criterion 5 was a single value (ConsumerManaged) asserted identically on
#     all 24 categories. A criterion that never varies contributes nothing.
#   - criterion 1 was a flat 12-value bag mixing link-layer radios with
#     application protocols, tested only as "has some protocol".
#   - criterion 3 asserted Residential on all 24 while Prosumer/Commercial/
#     Industrial sat declared and never used once.
#   - criterion 4's Role class had exactly one member, collapsing the three
#     distinct mechanisms the prose criterion itself names.
#
# ADMISSION RULE (the dominance check). A facet earns its place only if the
# positive cell is not dominated by one category. Measured over the 1,733
# confirmed-Yes CVEs: hiot:capturesAV=true is 1,120 rows of which cameras alone
# is 881 (79%) — it is very nearly a rename of `cameras`, and a finding stated
# over it is really a finding about cameras. hiot:actuatesPhysical=true is 388
# rows spread over 13 categories, none above 23%. Facets added here were chosen
# to look like the second case, not the first.
#
# n-FLOOR. 1,733 confirmed CVEs over 24 categories. Any facet finer than binary
# must be reportable at the 13-family fold level (--group family), not per
# category, or the cells are too small to publish. This is the same tail problem
# the folding categories exist to fix.
################################################################################

# --- criterion 1 refinement: connectivity ------------------------------------
# hiot:hasConnectivity itself is UNCHANGED (the axiom tests it). What changed is
# that its values are now typed: see hiot:LinkLayerProtocol / hiot:AppProtocol.

hiot:cloudDependence a owl:ObjectProperty ; rdfs:label "cloud dependence" ;
  rdfs:comment """Whether the device's primary control path requires vendor cloud. The RQ3 hypothesis this exists to test: a device's connectivity profile should PREDICT its CVSS Attack Vector distribution (AV:N for cloud-required, AV:A for local-mesh). The flat protocol bag could not express that hypothesis, let alone test it.""" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:CloudDependence .
hiot:topology a owl:ObjectProperty ; rdfs:label "network topology" ;
  rdfs:comment "How the device is reached. Multi-valued: a hub is both directly addressable and the mediator for others." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:Topology .
hiot:pairingModel a owl:ObjectProperty ; rdfs:label "pairing model" ;
  rdfs:comment "How a device is enrolled. Onboarding is a recurring weakness locus (unauthenticated pairing windows, static setup PINs); multi-valued because most categories support more than one route." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:PairingModel .

# --- criterion 2 refinement: device class ------------------------------------

hiot:computeTier a owl:ObjectProperty ; rdfs:label "compute tier" ;
  rdfs:comment """Software substrate, which is what actually predicts weakness class: embedded-Linux devices carry the web/network stack CWEs (command injection, path traversal), MCU-class devices carry memory-safety ones. Cross-cuts the 24 categories and subdivides cameras, which hiot:hasDeviceClass does not.""" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:ComputeTier .
hiot:hasWebAdminUI a owl:DatatypeProperty ; rdfs:label "has web admin UI" ;
  rdfs:comment "True when the device typically exposes an HTTP(S) administrative interface on the LAN. This is the precondition for CWE-79 / CWE-22 / CWE-352 existing on the device at all, so it is the single highest-value discriminator added here." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .
hiot:firmwareUpdateModel a owl:ObjectProperty ; rdfs:label "firmware update model" ;
  rdfs:comment "How patches reach the device. Bears directly on whether a disclosed CVE is realistically remediated in the field — the 'without dedicated IT security oversight' clause in operational form." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:FirmwareUpdateModel .

# --- criterion 3 refinement: deployment context ------------------------------
# hiot:hasDeployment stays hiot:Residential on all 24 (the axiom tests it).
# These record the market reality the single value flattens away.

hiot:alsoDeployedIn a owl:ObjectProperty ; rdfs:label "also deployed in" ;
  rdfs:comment """Non-residential contexts the same product line genuinely serves. Activates the Prosumer/Commercial/Industrial vocabulary, which was declared from the start and never asserted. This is what makes 'cameras is contaminated by pro surveillance' a queryable property rather than a remark in a scope note.""" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:DeploymentContext .
hiot:consumerAvailability a owl:ObjectProperty ; rdfs:label "consumer availability" ;
  rdfs:comment """Sales channel: can a non-expert consumer buy and self-install it? This encodes the rule the human reviewers ALREADY used to settle the pro-camera Yes/No disagreements (see the human-review reconciliation record) — moving it from an undocumented heuristic into a machine-checkable facet, the same win as the reasoner reproducing the published rulings.""" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:ConsumerAvailability .

# --- criterion 4 refinement: function / role ---------------------------------

hiot:actuationConsequence a owl:ObjectProperty ; rdfs:label "actuation consequence" ;
  rdfs:comment """Graded refinement of hiot:actuatesPhysical: what a successful compromise can do in the physical world. The boolean states THAT there is a consequence; this states how bad. RQ2 turns on exactly this gap — CVSS impact metrics model confidentiality/integrity/availability of data and have no term for 'unlocks the front door' or 'energizes a heating element'. With only 388 actuating rows, report this at family level.""" ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:ActuationConsequence .
hiot:dataSensitivity a owl:ObjectProperty ; rdfs:label "data sensitivity" ;
  rdfs:comment "Graded refinement of hiot:capturesAV, which currently does double duty for 'has a camera' and 'handles sensitive data'. Separating them is what stops the AV facet from being read as a privacy claim when it is really a hardware claim." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:DataSensitivity .

# --- criterion 5 refinement: security context --------------------------------
# hiot:hasSecurityContext stays ConsumerManaged on all 24 (the axiom tests it).
# These are the four ways that single constant actually varies in the field.

hiot:adminModel a owl:ObjectProperty ; rdfs:label "administration model" ;
  rdfs:comment "How the owner administers the device. Determines whether an authentication weakness is reachable from the LAN, from the vendor cloud, or not at all." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:AdminModel .
hiot:credentialModel a owl:ObjectProperty ; rdfs:label "credential model" ;
  rdfs:comment "How the device authenticates its owner at first use. Maps directly onto CWE-798 (hardcoded credentials), a top CWE-888 class in this study's own RQ1 results — which is why this is the first of the criterion-5 facets worth building." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:CredentialModel .
hiot:patchResponsibility a owl:ObjectProperty ; rdfs:label "patch responsibility" ;
  rdfs:comment "Who must act for a fix to land. The operational content of 'without dedicated IT security oversight': a user-initiated patch on a consumer device is, in practice, frequently no patch." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:PatchResponsibility .
hiot:supportLifetime a owl:ObjectProperty ; rdfs:label "support lifetime" ;
  rdfs:comment "Whether the vendor publishes an end-of-support date. Undeclared lifetime is the norm in consumer IoT and is why a disclosed CVE can remain live indefinitely." ;
  rdfs:domain hiot:DeviceType ; rdfs:range hiot:SupportLifetime .

hiot:slug a owl:DatatypeProperty ; rdfs:label "slug" ;
  rdfs:comment "Pipeline identifier. Primary key of data/categories.csv and of judgment_store.csv (category, cve_id)." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .
hiot:sortOrder a owl:DatatypeProperty ; rdfs:label "sort order" ;
  rdfs:comment "Row order in the generated categories.csv. cwe888_analysis.py reads that order into cat_order and uses it for table row ordering." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:integer .
hiot:provisional a owl:DatatypeProperty ; rdfs:label "provisional" ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .
hiot:openScopeCall a owl:DatatypeProperty ; rdfs:label "open scope call" ;
  rdfs:comment "An unsettled boundary question. Must be empty before the reasoner validation in Phase 3 is considered binding." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .
hiot:resolvedScopeCall a owl:DatatypeProperty ; rdfs:label "resolved scope call" ;
  rdfs:comment "A boundary question that WAS open and has been settled, with the evidence that settled it. Kept rather than deleted so the paper can cite why the call went the way it did." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .
hiot:noNvdFootprint a owl:DatatypeProperty ; rdfs:label "no NVD footprint" ;
  rdfs:comment """True when a category satisfies all five DEFINITIONAL criteria but fails the paper's
operational STUDY-INCLUSION criterion ('has a CPE-identifiable footprint in NVD and is subject to
CVE disclosure'). This is a different and weaker exclusion than hiot:failsCriteria: the device
class is genuinely home IoT, it is simply invisible to NVD. Such categories stay in the ontology
and in categories.csv (so the pipeline and the frozen 24-category scope are untouched) but
contribute no rows to RQ1/RQ2 — which is a finding about NVD coverage, not an embarrassment.
Requires an rdfs:comment recording the evidence, enforced by shapes.ttl.""" ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:boolean .
hiot:failsCriteria a owl:DatatypeProperty ; rdfs:label "fails criteria" ;
  rdfs:comment "Which definitional criteria an excluded type fails, as published in the paper." ;
  rdfs:domain hiot:DeviceType ; rdfs:range xsd:string .

################################################################################
# Facet value vocabularies (closed)
################################################################################

hiot:Protocol a owl:Class .
hiot:DeviceClass a owl:Class .
hiot:DeploymentContext a owl:Class .
hiot:Function a owl:Class .
hiot:Role a owl:Class .
hiot:SecurityContext a owl:Class .
hiot:FormFactor a owl:Class .
hiot:Placement a owl:Class .

# Sub-facet value classes (see "Descriptive sub-facets" above).
hiot:CloudDependence a owl:Class .
hiot:Topology a owl:Class .
hiot:PairingModel a owl:Class .
hiot:ComputeTier a owl:Class .
hiot:FirmwareUpdateModel a owl:Class .
hiot:ConsumerAvailability a owl:Class .
hiot:ActuationConsequence a owl:Class .
hiot:DataSensitivity a owl:Class .
hiot:AdminModel a owl:Class .
hiot:CredentialModel a owl:Class .
hiot:PatchResponsibility a owl:Class .
hiot:SupportLifetime a owl:Class .

# --- criterion 1 values, now TYPED --------------------------------------------
# The 12 protocol individuals are unchanged and every one is still a hiot:Protocol,
# so the equivalence axiom's `someValuesFrom hiot:Protocol` is untouched. What is
# new is the layer split: the flat bag mixed link-layer radios (how the device is
# physically reachable, which bears on CVSS Attack Vector) with application
# protocols (what speaks over that link, which bears on weakness class). Both types
# are asserted explicitly rather than left to subclass inference — the reasoner
# reasoner gate must not depend on OWL-RL type propagation to keep passing.
hiot:LinkLayerProtocol a owl:Class ; rdfs:subClassOf hiot:Protocol ;
  rdfs:label "link-layer protocol" .
hiot:AppProtocol a owl:Class ; rdfs:subClassOf hiot:Protocol ;
  rdfs:label "application-layer protocol" .

hiot:wifi     a hiot:Protocol, hiot:LinkLayerProtocol .
hiot:ethernet a hiot:Protocol, hiot:LinkLayerProtocol .
hiot:zigbee   a hiot:Protocol, hiot:LinkLayerProtocol .
hiot:zwave    a hiot:Protocol, hiot:LinkLayerProtocol .
hiot:thread   a hiot:Protocol, hiot:LinkLayerProtocol .
hiot:ble      a hiot:Protocol, hiot:LinkLayerProtocol .
hiot:cellular a hiot:Protocol, hiot:LinkLayerProtocol .
# Matter is application-layer: it runs OVER Wi-Fi, Thread, or Ethernet.
hiot:matter   a hiot:Protocol, hiot:AppProtocol .
hiot:mqtt     a hiot:Protocol, hiot:AppProtocol .
hiot:coap     a hiot:Protocol, hiot:AppProtocol .
hiot:rtsp     a hiot:Protocol, hiot:AppProtocol .
hiot:onvif    a hiot:Protocol, hiot:AppProtocol .

hiot:LocalOnly a hiot:CloudDependence ; rdfs:label "local-only" ;
  rdfs:comment "Fully controllable with no vendor cloud reachable." .
hiot:CloudOptional a hiot:CloudDependence ; rdfs:label "cloud-optional" ;
  rdfs:comment "Local control works; cloud adds remote access and is the common default." .
hiot:CloudRequired a hiot:CloudDependence ; rdfs:label "cloud-required" ;
  rdfs:comment "Primary control path traverses vendor cloud; the device is inert without it." .

hiot:DirectIP a hiot:Topology ; rdfs:label "directly addressable" .
hiot:MeshLeaf a hiot:Topology ; rdfs:label "mesh leaf" ;
  rdfs:comment "Reachable only through a mesh (Zigbee/Z-Wave/Thread), never routable from the internet on its own." .
hiot:HubMediated a hiot:Topology ; rdfs:label "hub-mediated" ;
  rdfs:comment "Control passes through a separate controller; the hub is the exposed surface, not the device." .

hiot:BleProvisioned a hiot:PairingModel ; rdfs:label "BLE provisioning" .
hiot:WpsPaired a hiot:PairingModel ; rdfs:label "WPS / AP-mode setup" .
hiot:QrPaired a hiot:PairingModel ; rdfs:label "QR / setup-code paired" .
hiot:AccountLinked a hiot:PairingModel ; rdfs:label "cloud-account linked" .
hiot:MeshJoin a hiot:PairingModel ; rdfs:label "mesh join (Zigbee/Z-Wave/Thread)" .

# --- criterion 2 values --------------------------------------------------------
hiot:EmbeddedSensor a hiot:DeviceClass . hiot:EmbeddedAppliance a hiot:DeviceClass .
hiot:EmbeddedController a hiot:DeviceClass . hiot:GeneralPurposeCompute a hiot:DeviceClass .

hiot:McuClass a hiot:ComputeTier ; rdfs:label "MCU-class (no OS)" ;
  rdfs:comment "Bare-metal microcontroller. Weaknesses skew to memory safety; no web stack to attack." .
hiot:Rtos a hiot:ComputeTier ; rdfs:label "RTOS" .
hiot:EmbeddedLinux a hiot:ComputeTier ; rdfs:label "embedded Linux" ;
  rdfs:comment "Full network/web stack, busybox userland, often a vendor CGI admin interface. The tier that carries injection and traversal weaknesses." .
hiot:AndroidDerived a hiot:ComputeTier ; rdfs:label "Android-derived" ;
  rdfs:comment "Android/AOSP or a fork (Fire OS, Google TV, Tizen, webOS). Inherits the mobile platform's CVE stream, which is why streaming needs a volume ruling rather than a scope ruling." .

hiot:OtaAutomatic a hiot:FirmwareUpdateModel ; rdfs:label "automatic OTA" .
hiot:OtaUserInitiated a hiot:FirmwareUpdateModel ; rdfs:label "user-initiated OTA" .
hiot:ManualFlash a hiot:FirmwareUpdateModel ; rdfs:label "manual flash" .
hiot:NoUpdatePath a hiot:FirmwareUpdateModel ; rdfs:label "no update path" .

# --- criterion 3 values --------------------------------------------------------
hiot:Residential a hiot:DeploymentContext . hiot:Prosumer a hiot:DeploymentContext .
hiot:Commercial a hiot:DeploymentContext . hiot:Industrial a hiot:DeploymentContext .

hiot:RetailConsumer a hiot:ConsumerAvailability ; rdfs:label "retail consumer" ;
  rdfs:comment "Bought off the shelf and self-installed by a non-expert." .
hiot:MixedChannel a hiot:ConsumerAvailability ; rdfs:label "mixed channel" ;
  rdfs:comment "Sold both retail and through installers — the ambiguous case that generates most reviewer disagreement (e.g. Hikvision/Dahua camera lines)." .
hiot:InstallerChannel a hiot:ConsumerAvailability ; rdfs:label "installer channel" ;
  rdfs:comment "Normally specified and commissioned by a trade installer, even when technically purchasable." .

# --- criterion 4 values --------------------------------------------------------
hiot:Monitor a hiot:Function . hiot:Automate a hiot:Function . hiot:Control a hiot:Function .
hiot:MediaPlayback a hiot:Function . hiot:Transport a hiot:Function .

# Criterion 4(b) was one undifferentiated value, hiot:HomeControlSurface, even
# though the prose criterion names three separate mechanisms ("acts as a
# Matter/Thread controller or border router, runs a voice assistant, or surfaces
# camera/sensor feeds"). Collapsing them discarded a distinction the definition
# already draws for free. The four values below replace it; hiot:HomeControlSurfaceRole
# groups them for the equivalence axiom, so criterion 4(b) still means exactly what
# it meant and the published rulings are unaffected.
hiot:ControllerRole a hiot:Role ; rdfs:label "IoT controller / border router" ;
  rdfs:comment "Discovers and commands other home IoT devices (Matter/Thread/Zigbee/Z-Wave)." .
hiot:AssistantRole a hiot:Role ; rdfs:label "voice assistant surface" ;
  rdfs:comment "Runs an assistant that actuates other home IoT devices by voice." .
hiot:FeedSurfaceRole a hiot:Role ; rdfs:label "feed / state surface" ;
  rdfs:comment "Displays another device's camera feed or sensor state (a TV showing the doorbell)." .
hiot:AutomationEngineRole a hiot:Role ; rdfs:label "automation engine" ;
  rdfs:comment "Evaluates user-authored rules across devices. Distinct from ControllerRole: a Hue Bridge controls without an engine; Home Assistant does both." .

hiot:NoActuation a hiot:ActuationConsequence ; rdfs:label "no physical actuation" .
hiot:ComfortActuation a hiot:ActuationConsequence ; rdfs:label "comfort" ;
  rdfs:comment "Reversible, non-damaging: a light, a fan, a blind." .
hiot:PropertyActuation a hiot:ActuationConsequence ; rdfs:label "property / access" ;
  rdfs:comment "Bears on physical security or property: a lock, a garage door, a valve." .
hiot:SafetyActuation a hiot:ActuationConsequence ; rdfs:label "safety" ;
  rdfs:comment "Can injure or start a fire: a heating element, an oven, a breaker, a high-current EVSE." .

hiot:NoData a hiot:DataSensitivity ; rdfs:label "no sensitive data" .
hiot:TelemetryData a hiot:DataSensitivity ; rdfs:label "telemetry" ;
  rdfs:comment "State and usage traces. Occupancy inference is the privacy risk, not content." .
hiot:AvStreamData a hiot:DataSensitivity ; rdfs:label "audio/video stream" .
hiot:BiometricData a hiot:DataSensitivity ; rdfs:label "biometric" ;
  rdfs:comment "Fingerprint/face templates or physiological signals." .

# --- criterion 5 values --------------------------------------------------------
hiot:ConsumerManaged a hiot:SecurityContext . hiot:ProfessionallyAdministered a hiot:SecurityContext .

hiot:NoAdminInterface a hiot:AdminModel ; rdfs:label "no admin interface" .
hiot:AppOnlyAdmin a hiot:AdminModel ; rdfs:label "app-only" .
hiot:LocalWebAdmin a hiot:AdminModel ; rdfs:label "local web admin" ;
  rdfs:comment "An HTTP admin surface on the LAN — the classic consumer-IoT exposure." .
hiot:CloudPortalAdmin a hiot:AdminModel ; rdfs:label "cloud portal" .

hiot:DefaultPassword a hiot:CredentialModel ; rdfs:label "shipped default password" ;
  rdfs:comment "The CWE-798 case: a documented or hardcoded credential present until the owner changes it, which most never do." .
hiot:ForcedCredentialSetup a hiot:CredentialModel ; rdfs:label "forced setup credential" ;
  rdfs:comment "Setup refuses to complete until a unique credential is chosen." .
hiot:AccountBound a hiot:CredentialModel ; rdfs:label "cloud-account bound" .
hiot:CertificateBound a hiot:CredentialModel ; rdfs:label "certificate / attestation bound" ;
  rdfs:comment "Per-device attestation, as Matter requires." .
hiot:NoCredential a hiot:CredentialModel ; rdfs:label "no credential" ;
  rdfs:comment "Possession of the radio link is the only authentication — common on cheap mesh leaves." .

hiot:VendorPatched a hiot:PatchResponsibility ; rdfs:label "vendor-pushed" .
hiot:UserPatched a hiot:PatchResponsibility ; rdfs:label "user-initiated" .
hiot:InstallerPatched a hiot:PatchResponsibility ; rdfs:label "installer-serviced" .
hiot:Unmaintained a hiot:PatchResponsibility ; rdfs:label "unmaintained" .

hiot:DeclaredLifetime a hiot:SupportLifetime ; rdfs:label "declared end-of-support" .
hiot:UndeclaredLifetime a hiot:SupportLifetime ; rdfs:label "undeclared" ;
  rdfs:comment "The consumer-IoT norm: no published support window, so a disclosed CVE can stay live indefinitely." .

hiot:Fixed a hiot:FormFactor . hiot:Portable a hiot:FormFactor . hiot:Worn a hiot:FormFactor .
hiot:Indoor a hiot:Placement . hiot:Outdoor a hiot:Placement . hiot:Either a hiot:Placement .

################################################################################
# The five criteria as an OWL equivalence axiom
#
# A device type is in scope iff it satisfies ALL five. Criterion 4 is the
# disjunction: a home-control FUNCTION (4a) OR a home-control-surface ROLE (4b).
# This is what admits streaming/smartspeakers (function is MediaPlayback, but they
# carry ControllerRole/AssistantRole/FeedSurfaceRole) while excluding game consoles
# (same function, no role at all, and GeneralPurposeCompute already fails
# criterion 2).
################################################################################

hiot:DeviceType a owl:Class ; rdfs:label "device type" .

# NOTE ON PUNNING. Each device type is declared BOTH as an owl:Class
# (so families can subclass it and the taxonomy is a real hierarchy) AND as an
# individual of hiot:DeviceType (so the criteria axiom below can classify it).
# Facet values are individuals, so value groupings use owl:oneOf, not owl:unionOf
# — union is over classes, and using it over individuals would silently produce
# an axiom no reasoner acts on.

hiot:SpecialPurposeEmbedded a owl:Class ;
  rdfs:label "special-purpose embedded" ;
  owl:equivalentClass [ a owl:Class ;
    owl:oneOf (hiot:EmbeddedSensor hiot:EmbeddedAppliance hiot:EmbeddedController) ] .

hiot:GeneralPurposeComputeClass a owl:Class ;
  rdfs:label "general-purpose compute" ;
  owl:equivalentClass [ a owl:Class ; owl:oneOf (hiot:GeneralPurposeCompute) ] ;
  owl:disjointWith hiot:SpecialPurposeEmbedded .

hiot:HomeControlFunction a owl:Class ;
  rdfs:label "home-control function" ;
  owl:equivalentClass [ a owl:Class ;
    owl:oneOf (hiot:Monitor hiot:Automate hiot:Control) ] .

# Criterion 4(b), grouped. Previously the axiom pinned a single individual
# (owl:hasValue hiot:HomeControlSurface); it now admits any of the four named
# mechanisms via owl:someValuesFrom. The criterion's MEANING is unchanged — the
# prose already listed these three routes plus the rule engine — so the published
# in/out rulings must not move. That is exactly what the reasoner gate verifies.
hiot:HomeControlSurfaceRole a owl:Class ;
  rdfs:label "home-control surface role" ;
  owl:equivalentClass [ a owl:Class ;
    owl:oneOf (hiot:ControllerRole hiot:AssistantRole
               hiot:FeedSurfaceRole hiot:AutomationEngineRole) ] .

hiot:InScopeDeviceType a owl:Class ;
  rdfs:label "in-scope home IoT device type" ;
  owl:equivalentClass [
    a owl:Class ; owl:intersectionOf (
      hiot:DeviceType
      [ a owl:Restriction ; owl:onProperty hiot:hasConnectivity ; owl:someValuesFrom hiot:Protocol ]
      [ a owl:Restriction ; owl:onProperty hiot:hasDeviceClass ; owl:someValuesFrom hiot:SpecialPurposeEmbedded ]
      [ a owl:Restriction ; owl:onProperty hiot:hasDeployment ; owl:hasValue hiot:Residential ]
      [ a owl:Class ; owl:unionOf (
          [ a owl:Restriction ; owl:onProperty hiot:hasFunction ; owl:someValuesFrom hiot:HomeControlFunction ]
          [ a owl:Restriction ; owl:onProperty hiot:hasRole ; owl:someValuesFrom hiot:HomeControlSurfaceRole ] ) ]
      [ a owl:Restriction ; owl:onProperty hiot:hasSecurityContext ; owl:hasValue hiot:ConsumerManaged ]
    ) ] .

hiot:ExcludedDeviceType a owl:Class ;
  rdfs:label "defined but excluded device type" ;
  rdfs:comment "Satisfies connectivity but fails the class and/or function criteria. Defined so the boundary is stated rather than implied; kept out of the analysis set." .

################################################################################
# Families
################################################################################

hiot:CamerasMonitorsDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Cameras and Monitors" ;
  hiot:familyId "CamerasMonitors" ;
  rdfs:comment """cameras + doorbell + babymonitor. Folded despite differing brand sets: at the high level a consumer reads all three as the same product class (a networked camera in the home). The granularity rule keeps them separate as ANALYSIS categories; this folding is the abstract view over them.""" .

hiot:HubsControllersDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Hubs and Controllers" ;
  hiot:familyId "HubsControllers" ;
  rdfs:comment """hub, standalone. Kept unfolded because n is large enough to stand alone, and because its qualifying function is criterion 4(a) primary home control — not the 4(b) control-surface route that admits Entertainment and Audio.""" .

hiot:AlarmsSensorsDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Alarms & Sensors" ;
  hiot:familyId "AlarmsSensors" ;
  rdfs:comment """alarms + sensors. Folded on shared function and heavily overlapping brand sets (the sensors brand list overlaps alarms by design).""" .

hiot:EntertainmentDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Entertainment" ;
  hiot:familyId "Entertainment" ;
  rdfs:comment """streaming, standalone. In scope only via criterion 4(b) — the platform acts as a Matter/Thread controller and surfaces camera feeds.""" .

hiot:ElectricalLightingDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Electrical & Lighting" ;
  hiot:familyId "ElectricalLighting" ;
  rdfs:comment """smartplugs + lighting. Folded as switched mains loads in the home's electrical fabric — distinct from Energy, which generates, stores, or meters power.""" .

hiot:EnergyDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Energy" ;
  hiot:familyId "Energy" ;
  rdfs:comment """ev-charging + home-power. Generation, storage, and metering of household power.""" .

hiot:OutdoorPetDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Outdoor & Pet" ;
  hiot:familyId "OutdoorPet" ;
  rdfs:comment """garden + pet. Folded as the household's living-things tier — irrigation, mowers, feeders, litter boxes, pet cameras.""" .

hiot:AudioDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Audio" ;
  hiot:familyId "Audio" ;
  rdfs:comment """smartspeakers, standalone. In scope via criterion 4(b), same route as Entertainment, but kept separate: n is large enough and the brand set is distinct.""" .

hiot:AppliancesDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Appliances" ;
  hiot:familyId "Appliances" ;
  rdfs:comment """robotvacuum + fridge + appliances. Folded as consumer white goods and chore automation.""" .

hiot:AccessControlDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Access Control" ;
  hiot:familyId "AccessControl" ;
  rdfs:comment """doorlock, standalone. Kept unfolded because n is large enough and physical access control is its own threat surface.""" .

hiot:ClimateAirDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Climate & Air" ;
  hiot:familyId "ClimateAir" ;
  rdfs:comment """thermostat + airconditioner + fans + airpurifier. Folded as devices that monitor or regulate the home's thermal and air environment.""" .

hiot:SleepDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Sleep" ;
  hiot:familyId "Sleep" ;
  rdfs:comment """sleeptracker, standalone. n = 0; PROVISIONAL — the category is ~88% wrist wearables (out by criterion 3) and is pending rebuild.""" .

hiot:ShadesDevice a owl:Class ;
  rdfs:subClassOf hiot:InScopeDeviceType ;
  rdfs:label "Shades" ;
  hiot:familyId "Shades" ;
  rdfs:comment """shades, standalone. n = 0 in the current snapshot; kept as its own fold rather than merged, per the supervisor-agreed list.""" .

