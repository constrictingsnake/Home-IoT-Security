  hiot:hasConnectivity hiot:wifi, hiot:ethernet, hiot:ble, hiot:cellular ;
  hiot:hasDeviceClass hiot:EmbeddedController ;
  hiot:hasDeployment hiot:Residential ;
  hiot:hasFunction hiot:Monitor, hiot:Control ;
  hiot:hasSecurityContext hiot:ConsumerManaged ;
  hiot:formFactor hiot:Fixed ;
  hiot:placement hiot:Either ;
  hiot:actuatesPhysical true ;
  hiot:capturesAV false ;
  hiot:openScopeCall """Boundary with home-power not finally settled: a wallbox that meters and load-balances against a home battery arguably belongs to either.""" ;
  skos:scopeNote """IN: home EVSE/wallbox for a private garage or driveway. OUT: commercial/public/fleet chargers (Iocharger, Circontrol, Raption, eCharge) and the vehicle itself.""" .

