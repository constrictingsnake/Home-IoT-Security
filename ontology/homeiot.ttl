  hiot:hasSecurityContext hiot:ConsumerManaged ;
  hiot:formFactor hiot:Fixed ;
  hiot:placement hiot:Indoor ;
  hiot:actuatesPhysical false ;
  hiot:capturesAV true ;
  hiot:cloudDependence hiot:CloudRequired ;
  hiot:topology hiot:DirectIP ;
  hiot:pairingModel hiot:BleProvisioned, hiot:AccountLinked ;
  hiot:computeTier hiot:EmbeddedLinux ;
