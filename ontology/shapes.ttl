@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix hiot:  <https://w3id.org/homeiot/ontology#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

################################################################################
# SHACL shapes for the Home IoT device ontology.
#
# Catches the errors a reasoner will not: a category missing a facet, a duplicate
# sortOrder (which would silently reorder categories.csv and with it the RQ1 table
# rows), a slug that does not match the pipeline's key format, a missing scopeNote
# (which would blank the note gemini_classify.py injects into reviewer prompts).
#
# Run via: python3 scripts/ontology_build.py --check
################################################################################

hiot:DeviceTypeShape a sh:NodeShape ;
  sh:targetClass hiot:DeviceType ;

  sh:property [ sh:path hiot:slug ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]*$" ;
                sh:message "Every device type needs exactly one slug matching ^[a-z][a-z0-9-]*$ — it is the key of categories.csv and of judgment_store.csv (category, cve_id)." ] ;

  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:message "Every device type needs exactly one rdfs:label (the categories.csv `label` column)." ] ;

  # --- the five definitional criteria ---
  # NO minCount here. A defined-but-excluded type must be able to fail criterion 1,
  # and a device that fails criterion 1 is one with no connectivity at all — so
  # requiring connectivity on every hiot:DeviceType made the connectivity criterion
  # the one criterion no negative case could ever test. minCount moved to
  # AnalysisCategoryShape, where "in scope but not networked" really is a contradiction.
  sh:property [ sh:path hiot:hasConnectivity ; sh:class hiot:Protocol ;
                sh:message "Criterion 1: connectivity values must be hiot:Protocol." ] ;
  sh:property [ sh:path hiot:hasDeviceClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:DeviceClass ;
                sh:message "Criterion 2: exactly one device class." ] ;
  sh:property [ sh:path hiot:hasDeployment ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:DeploymentContext ;
                sh:message "Criterion 3: exactly one deployment context." ] ;
  sh:property [ sh:path hiot:hasFunction ; sh:minCount 1 ; sh:class hiot:Function ;
                sh:message "Criterion 4(a): at least one function. (4(b) via hiot:hasRole is optional.)" ] ;
  # Criterion 4(b). maxCount was 1 while hiot:Role had a single member; the role is
  # now split into its four named mechanisms and a device may legitimately carry
  # several (a streaming platform is controller + feed surface + assistant).
  sh:property [ sh:path hiot:hasRole ; sh:class hiot:Role ] ;
  sh:property [ sh:path hiot:hasSecurityContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:SecurityContext ;
                sh:message "Criterion 5: exactly one security context." ] ;

  # --- analysis facets (RQ1/RQ2), required so the ontology is never half-populated ---
  sh:property [ sh:path hiot:formFactor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:FormFactor ] ;
  sh:property [ sh:path hiot:placement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:Placement ] ;
  sh:property [ sh:path hiot:actuatesPhysical ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path hiot:capturesAV ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .


# An analysis category (as opposed to a defined-but-excluded type) is one whose
# parent carries a familyId. It additionally needs a sortOrder and a scopeNote.
hiot:AnalysisCategoryShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://w3id.org/homeiot/ontology#slug> ?s ;
              <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?p .
        ?p <https://w3id.org/homeiot/ontology#familyId> ?f .
      }""" ] ;

  sh:property [ sh:path hiot:sortOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                sh:message "Analysis categories need a sortOrder — it fixes categories.csv row order, which cwe888_analysis.py reads into cat_order for RQ1 table row ordering." ] ;
  sh:property [ sh:path skos:scopeNote ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:message "Analysis categories need a scopeNote — gemini_classify.py injects it into reviewer prompts; a missing one silently blanks the note." ] ;

  sh:property [ sh:path hiot:hasConnectivity ; sh:minCount 1 ; sh:class hiot:Protocol ;
                sh:message "Criterion 1: an in-scope analysis category must carry at least one connectivity protocol." ] ;

  # --- descriptive sub-facets ---------------------------------------------------
  # Required on the 24 ANALYSIS categories only, not on hiot:DeviceType at large:
  # the three defined-but-excluded types are boundary markers, and demanding a
  # credential model for "transport networking gear" would be noise. A half-populated
  # facet is worse than an absent one — it looks like data and analyses as a bias.
  sh:property [ sh:path hiot:cloudDependence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:CloudDependence ] ;
  sh:property [ sh:path hiot:topology ; sh:minCount 1 ; sh:class hiot:Topology ] ;
  sh:property [ sh:path hiot:pairingModel ; sh:minCount 1 ; sh:class hiot:PairingModel ] ;
  sh:property [ sh:path hiot:computeTier ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:ComputeTier ] ;
  sh:property [ sh:path hiot:hasWebAdminUI ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path hiot:firmwareUpdateModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:FirmwareUpdateModel ] ;
  sh:property [ sh:path hiot:consumerAvailability ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:ConsumerAvailability ] ;
  sh:property [ sh:path hiot:actuationConsequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:ActuationConsequence ] ;
  sh:property [ sh:path hiot:dataSensitivity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:DataSensitivity ] ;
  sh:property [ sh:path hiot:adminModel ; sh:minCount 1 ; sh:class hiot:AdminModel ] ;
  sh:property [ sh:path hiot:credentialModel ; sh:minCount 1 ; sh:class hiot:CredentialModel ] ;
  sh:property [ sh:path hiot:patchResponsibility ; sh:minCount 1 ; sh:class hiot:PatchResponsibility ] ;
  sh:property [ sh:path hiot:supportLifetime ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hiot:SupportLifetime ] ;
  # alsoDeployedIn is deliberately OPTIONAL — most categories are residential-only,
  # and asserting an empty non-residential context would be a claim, not a blank.
  sh:property [ sh:path hiot:alsoDeployedIn ; sh:class hiot:DeploymentContext ] .


# The graded facets REFINE the two booleans rather than replacing them: kg_queries.py
# still reads hiot:actuatesPhysical and hiot:capturesAV, and the RQ2 discussion cites
# them. Two sources of truth for one fact is how they silently drift apart, so these
# two constraints pin the refinement to its boolean. Editing one without the other
# now fails the build instead of quietly producing two different answers.
hiot:ActuationConsistencyShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://w3id.org/homeiot/ontology#actuationConsequence> ?c }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "hiot:actuatesPhysical and hiot:actuationConsequence disagree: the boolean is true iff the graded value is anything other than hiot:NoActuation." ;
    sh:select """
      SELECT $this WHERE {
        { $this <https://w3id.org/homeiot/ontology#actuatesPhysical> true ;
                <https://w3id.org/homeiot/ontology#actuationConsequence>
                  <https://w3id.org/homeiot/ontology#NoActuation> }
        UNION
        { $this <https://w3id.org/homeiot/ontology#actuatesPhysical> false ;
                <https://w3id.org/homeiot/ontology#actuationConsequence> ?c .
          FILTER (?c != <https://w3id.org/homeiot/ontology#NoActuation>) }
      }""" ] .


hiot:DataSensitivityConsistencyShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://w3id.org/homeiot/ontology#dataSensitivity> ?d }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "hiot:capturesAV and hiot:dataSensitivity disagree: the boolean is true iff the graded value is hiot:AvStreamData. (hiot:BiometricData does NOT imply a camera or microphone — a fingerprint lock is biometric with capturesAV false, which is precisely the conflation splitting these two facets exists to remove.)" ;
    sh:select """
      SELECT $this WHERE {
        { $this <https://w3id.org/homeiot/ontology#capturesAV> true .
          FILTER NOT EXISTS { $this <https://w3id.org/homeiot/ontology#dataSensitivity>
                                    <https://w3id.org/homeiot/ontology#AvStreamData> } }
        UNION
        { $this <https://w3id.org/homeiot/ontology#capturesAV> false ;
                <https://w3id.org/homeiot/ontology#dataSensitivity>
                  <https://w3id.org/homeiot/ontology#AvStreamData> }
      }""" ] .


# sortOrder must be unique, or categories.csv row order becomes non-deterministic.
hiot:SortOrderUniqueShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE { ?this <https://w3id.org/homeiot/ontology#sortOrder> ?o }""" ] ;
  sh:sparql [ a sh:SPARQLConstraint ;
    sh:message "Duplicate hiot:sortOrder — categories.csv row order would be non-deterministic." ;
    sh:prefixes hiot: ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/homeiot/ontology#sortOrder> ?o .
        ?other <https://w3id.org/homeiot/ontology#sortOrder> ?o .
        FILTER (?other != $this)
      }""" ] .


# A category marked noNvdFootprint must record the evidence — otherwise the marker
# becomes a way to quietly retire an inconvenient category.
hiot:NoFootprintShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <https://w3id.org/homeiot/ontology#noNvdFootprint> true }""" ] ;
  sh:property [ sh:path rdfs:comment ; sh:minCount 1 ;
                sh:message "A category marked hiot:noNvdFootprint must record the evidence (judged count, whether the terms fired, why the survivors were No) in an rdfs:comment." ] .


# Every excluded type must say which criteria it fails — the paper publishes that.
hiot:ExcludedTypeShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ;
    sh:select """
      SELECT ?this WHERE {
        ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf>
              <https://w3id.org/homeiot/ontology#ExcludedDeviceType> }""" ] ;
  sh:property [ sh:path hiot:failsCriteria ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:message "A defined-but-excluded type must record which definitional criteria it fails." ] ;
  sh:property [ sh:path rdfs:comment ; sh:minCount 1 ;
                sh:message "A defined-but-excluded type must record the rationale for its exclusion." ] .
