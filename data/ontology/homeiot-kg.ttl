  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2021-31793_doorbell> ;
  hkg:cvssScore "7.5"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-306> ;
  hkg:published "2021-05-06"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2021-31793" .

