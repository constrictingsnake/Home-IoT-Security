  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-287> ;
  hkg:published "2020-02-24"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2019-20481" .

<https://w3id.org/homeiot/kg/cve/CVE-2019-25062>
  dcterms:description "A vulnerability was found in Sricam IP CCTV Camera and classified as critical. This issue affects some unknown processing of the component Device Viewer. The manipulation leads to memory corruption. An attack has to be approached locally. The exploit has been disclosed to the public and may be used." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/sricam/deviceviewer> ;
