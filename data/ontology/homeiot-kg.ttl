<https://w3id.org/homeiot/kg/cve/CVE-2021-27289>
  dcterms:description "A replay attack vulnerability was discovered in a Zigbee smart home kit manufactured by Ksix (Zigbee Gateway Module = v1.0.3, Door Sensor = v1.0.7, Motion Sensor = v1.0.12), where the Zigbee anti-replay mechanism - based on the frame counter field - is improperly implemented. As a result, an attacker within wireless range can resend captured packets with a higher sequence number, which the devices incorrectly accept as legitimate messages. This allows spoofed commands to be injected without authentication, triggering false alerts and misleading the user through notifications in the mobile application used to monitor the network." ;
  hkg:affectsCategory hiot:hub ;
  hkg:affectsCategory hiot:sensors ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2021-27289_hub> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2021-27289_sensors> ;
  hkg:cvssScore "9.1"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-294> ;
  hkg:published "2025-04-15"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2021-27289" .

