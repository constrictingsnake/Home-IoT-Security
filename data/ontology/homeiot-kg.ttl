  rdfs:label "CVE-2019-25063" .

<https://w3id.org/homeiot/kg/cve/CVE-2019-25236>
  dcterms:description "iSeeQ Hybrid DVR WH-H4 1.03R contains an unauthenticated vulnerability in the get_jpeg script that allows unauthorized access to live video streams. Attackers can retrieve video snapshots from specific camera channels by sending requests to the /cgi-bin/get_jpeg endpoint without authentication." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2019-25236_cameras> ;
  hkg:cvssScore "9.8"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-306> ;
  hkg:published "2025-12-24"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2019-25236" .

<https://w3id.org/homeiot/kg/cve/CVE-2019-25240>
  dcterms:description "Rifatron 5brid DVR contains an unauthenticated vulnerability in the animate.cgi script that allows unauthorized access to live video streams. Attackers can exploit the Mobile Web Viewer module by specifying channel numbers to retrieve sequential video snapshots without authentication." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2019-25240_cameras> ;
  hkg:cvssScore "9.8"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-306> ;
