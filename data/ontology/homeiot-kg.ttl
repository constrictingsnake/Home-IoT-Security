  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/-/wireless_ip_camera_360> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2017-11633_cameras> ;
  hkg:cvssScore "7.5"^^xsd:decimal ;
  hkg:cvssVersion "3.0" ;
  hkg:published "2018-02-26"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2017-11633" .

<https://w3id.org/homeiot/kg/cve/CVE-2017-11634>
  dcterms:description "An issue was discovered on Wireless IP Camera 360 devices. Remote attackers can discover a weakly encoded admin password by connecting to TCP port 9527 and reading the password field of the debugging information, e.g., nTBCS19C corresponds to a password of 123456." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/-/wireless_ip_camera_360> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2017-11634_cameras> ;
