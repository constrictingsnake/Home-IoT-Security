  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-522> ;
  hkg:published "2020-06-04"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2020-11681" .

<https://w3id.org/homeiot/kg/cve/CVE-2020-11682>
  dcterms:description "Castel NextGen DVR v1.0.0 is vulnerable to CSRF in all state-changing request. A __RequestVerificationToken is set by the web interface, and included in requests sent by web interface. However, this token is not verified by the application: the token can be removed from all requests and the request will succeed." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/castel/nextgen_dvr> ;
