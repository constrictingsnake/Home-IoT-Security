  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/chargepoint/home_flex_nema_6-50_plug> ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/chargepoint/home_flex_nema_6-50_plug_firmware> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2024-23921_ev-charging> ;
  hkg:cvssScore "8.8"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-94> ;
