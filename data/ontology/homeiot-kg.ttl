  hkg:cvssScore "6.5"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-319> ;
  hkg:published "2021-11-05"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2021-3774" .

