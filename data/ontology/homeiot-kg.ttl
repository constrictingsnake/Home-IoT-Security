  hkg:published "2025-07-30"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2025-8321" .

<https://w3id.org/homeiot/kg/cve/CVE-2025-9380>
  dcterms:description "A vulnerability was identified in FNKvision Y215 CCTV Camera 10.194.120.40. Affected by this issue is some unknown functionality of the file /etc/passwd of the component Firmware. Such manipulation leads to hard-coded credentials. Local access is required to approach this attack. The exploit is publicly available and might be used. The vendor was contacted early about this disclosure but did not respond in any way." ;
