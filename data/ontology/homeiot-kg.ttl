  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/edimax/ic-3140w_firmware> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2020-26762_cameras> ;
  hkg:cvssScore "9.8"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-787> ;
  hkg:published "2020-12-01"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2020-26762" .

<https://w3id.org/homeiot/kg/cve/CVE-2020-27402>
  dcterms:description "The HK1 Box S905X3 TV Box contains a vulnerability that allows a local unprivileged user to escalate to root using the /system/xbin/su binary via a serial port (UART) connection or using adb." ;
  hkg:affectsCategory hiot:streaming ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/hindotech/hk1_box_s905x3> ;
