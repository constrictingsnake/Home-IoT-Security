  rdfs:label "CVE-2024-23920" .

<https://w3id.org/homeiot/kg/cve/CVE-2024-23921>
  dcterms:description "This vulnerability allows network-adjacent attackers to execute arbitrary code on affected installations of ChargePoint Home Flex charging stations. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the wlanapp module. The issue results from the lack of proper validation of a user-supplied string before using it to execute a system call. An attacker can leverage this vulnerability to execute code in the context of root." ;
  hkg:affectsCategory hiot:ev_charging ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/chargepoint/home_flex_hardwired> ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/chargepoint/home_flex_hardwired_firmware> ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/chargepoint/home_flex_nema_14-50_plug> ;
