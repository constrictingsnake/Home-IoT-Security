  hkg:published "2026-01-12"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2025-65552" .

<https://w3id.org/homeiot/kg/cve/CVE-2025-65553>
  dcterms:description "D3D Wi-Fi Home Security System ZX-G12 v2.1.17 is susceptible to RF jamming on the 433 MHz alarm sensor channel. An attacker within RF range can transmit continuous interference to block sensor transmissions, resulting in missed alarms and loss of security monitoring. The device lacks jamming detection or mitigations, creating a denial-of-service condition that may lead to undetected intrusions or failure to trigger safety alerts." ;
  hkg:affectsCategory hiot:alarms ;
