  hkg:cvssScore "7.8"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-427> ;
  hkg:published "2020-04-01"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2020-8146" .

