  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-287> ;
  hkg:published "2020-03-05"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2020-8994" .

<https://w3id.org/homeiot/kg/cve/CVE-2020-9059>
  dcterms:description "Z-Wave devices based on Silicon Labs 500 series chipsets using S0 authentication are susceptible to uncontrolled resource consumption leading to battery exhaustion. As an example, the Schlage BE468 version 3.42 door lock is vulnerable and fails open at a low battery level." ;
