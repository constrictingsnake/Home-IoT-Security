<https://w3id.org/homeiot/kg/cve/CVE-2017-17761>
  dcterms:description "An issue was discovered on Ichano AtHome IP Camera devices. The device runs the \"noodles\" binary - a service on port 1300 that allows a remote (LAN) unauthenticated user to run arbitrary commands. This binary requires the \"system\" XML element for specifying the command. For example, a <system>id</system> command results in a <system_ack>ok</system_ack> response." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/ichano/athome_ip_camera> ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/ichano/athome_ip_camera_firmware> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2017-17761_cameras> ;
  hkg:cvssScore "9.8"^^xsd:decimal ;
  hkg:cvssVersion "3.0" ;
  hkg:published "2017-12-19"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2017-17761" .

