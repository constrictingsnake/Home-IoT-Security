  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-352> ;
  hkg:published "2020-06-04"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2020-11682" .

