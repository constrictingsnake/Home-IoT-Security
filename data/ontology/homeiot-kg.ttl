  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-284> ;
  hkg:published "2026-02-10"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2026-0653" .

<https://w3id.org/homeiot/kg/cve/CVE-2026-0778>
  dcterms:description "Enel X JuiceBox 40 Telnet Service Missing Authentication Remote Code Execution Vulnerability. This vulnerability allows network-adjacent attackers to execute arbitrary code on affected installations of Enel X JuiceBox 40 charging stations. Authentication is not required to exploit this vulnerability.\n\nThe specific flaw exists within the telnet service, which listens on TCP port 2000 by default. The issue results from the lack of authentication prior to allowing remote connections. An attacker can leverage this vulnerability to execute code in the context of the service account. Was ZDI-CAN-23285." ;
  hkg:affectsCategory hiot:ev_charging ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2026-0778_ev-charging> ;
  hkg:cvssScore "8.8"^^xsd:decimal ;
  hkg:cvssVersion "3.0" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-306> ;
  hkg:published "2026-01-23"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2026-0778" .

<https://w3id.org/homeiot/kg/cve/CVE-2026-0853>
  dcterms:description "Certain NVR models developed by A-Plus Video Technologies has a Sensitive Data Exposure vulnerability, allowing unauthenticated remote attackers to access the debug page and obtain device status information." ;
