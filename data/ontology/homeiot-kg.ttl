  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-347> ;
  hkg:published "2018-07-05"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2018-10988" .

