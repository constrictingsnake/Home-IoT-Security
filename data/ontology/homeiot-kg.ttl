  hkg:published "2017-04-25"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2017-8222" .

<https://w3id.org/homeiot/kg/cve/CVE-2017-8223>
  dcterms:description "On Wireless IP Camera (P2P) WIFICAM devices, an attacker can use the RTSP server on port 10554/tcp to watch the streaming without authentication via tcp/av0_1 or tcp/av0_0." ;
