  hkg:cvssScore "7.5"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-770> ;
  hkg:published "2023-04-25"^^xsd:date ;
