  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2025-5517" .

<https://w3id.org/homeiot/kg/cve/CVE-2025-55581>
  dcterms:description "D-Link DCS-825L firmware version 1.08.01 and possibly prior versions contain an insecure implementation in the mydlink-watch-dog.sh script. The script monitors and respawns the `dcp` and `signalc` binaries without validating their integrity, origin, or permissions. An attacker with filesystem access (e.g., via UART or firmware modification) may replace these binaries to achieve persistent arbitrary code execution with root privileges. The issue stems from improper handling of executable trust and absence of integrity checks in the watchdog logic." ;
  hkg:affectsCategory hiot:babymonitor ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/dlink/dcs-825l> ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/dlink/dcs-825l_firmware> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2025-55581_babymonitor> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2025-55581_cameras> ;
  hkg:cvssScore "7.3"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-269> ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-306> ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-494> ;
  hkg:published "2025-08-22"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2025-55581" .

<https://w3id.org/homeiot/kg/cve/CVE-2025-55582>
  dcterms:description "D-Link DCS-825L firmware v1.08.01 contains a vulnerability in the watchdog script `mydlink-watch-dog.sh`, which blindly respawns binaries such as `dcp` and `signalc` without verifying integrity, authenticity, or permissions. An attacker with local filesystem access (via physical access, firmware modification, or debug interfaces) can replace these binaries with malicious payloads. The script executes these binaries as root in an infinite loop, leading to persistent privilege escalation and arbitrary code execution. This issue is mitigated in v1.09.02, but the product is officially End-of-Life and unsupported." ;
  hkg:affectsCategory hiot:babymonitor ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/dlink/dcs-825l> ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/dlink/dcs-825l_firmware> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2025-55582_babymonitor> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2025-55582_cameras> ;
  hkg:cvssScore "6.6"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-269> ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-494> ;
  hkg:published "2025-08-27"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2025-55582" .

