  rdfs:label "CVE-2021-33818" .

<https://w3id.org/homeiot/kg/cve/CVE-2021-33820>
  dcterms:description "An issue was discovered in UniFi Protect G3 FLEX Camera Version UVC.v4.30.0.67.Attacker could send a huge amount of TCP SYN packet to make web service's resource exhausted. Then the web server is denial-of-service." ;
  hkg:affectsCategory hiot:cameras ;
