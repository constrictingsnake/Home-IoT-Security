<https://w3id.org/homeiot/kg/cve/CVE-2024-3721>
  dcterms:description "A vulnerability was found in TBK DVR-4104 and DVR-4216 up to 20240412 and classified as critical. This issue affects some unknown processing of the file /device.rsp?opt=sys&cmd=___S_O_S_T_R_E_A_MAX___. The manipulation of the argument mdb/mdc leads to os command injection. The attack may be initiated remotely. The exploit has been disclosed to the public and may be used. The identifier VDB-260573 was assigned to this vulnerability." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2024-3721_cameras> ;
  hkg:cvssScore "6.3"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-78> ;
  hkg:published "2024-04-13"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2024-3721" .

