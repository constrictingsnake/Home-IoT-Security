  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-200> ;
  hkg:published "2018-09-17"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2017-14443" .

<https://w3id.org/homeiot/kg/cve/CVE-2017-14444>
