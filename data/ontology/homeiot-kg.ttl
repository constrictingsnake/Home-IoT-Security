  hkg:cvssScore "8.8"^^xsd:decimal ;
  hkg:cvssVersion "3.1" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-352> ;
  hkg:published "2020-02-24"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2019-20480" .

<https://w3id.org/homeiot/kg/cve/CVE-2019-20481>
  dcterms:description "In MIELE XGW 3000 ZigBee Gateway before 2.4.0, the Password Change Function does not require knowledge of the old password. This can be exploited in conjunction with CVE-2019-20480." ;
  hkg:affectsCategory hiot:hub ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/miele/xgw_3000_zigbee_gateway> ;
