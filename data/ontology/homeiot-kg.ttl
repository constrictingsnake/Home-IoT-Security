  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2021-4468" .

<https://w3id.org/homeiot/kg/cve/CVE-2021-4469>
  dcterms:description "Denver SHO-110 IP cameras expose a secondary HTTP service on TCP port 8001 that provides access to a '/snapshot' endpoint without authentication. While the primary web interface on port 80 enforces authentication, the backdoor service allows any remote attacker to retrieve image snapshots by directly requesting the 'snapshot' endpoint. An attacker can repeatedly collect snapshots and reconstruct the camera stream, compromising the confidentiality of the monitored environment." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2021-4469_cameras> ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-1242> ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-306> ;
  hkg:published "2025-11-14"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2021-4469" .

