  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2018-18767_cameras> ;
  hkg:cvssScore "7.0"^^xsd:decimal ;
  hkg:cvssVersion "3.0" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-326> ;
  hkg:published "2018-12-20"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2018-18767" .

<https://w3id.org/homeiot/kg/cve/CVE-2018-19063>
  dcterms:description "An issue was discovered on Foscam C2 devices with System Firmware 1.11.1.8 and Application Firmware 2.72.1.32, and Opticam i5 devices with System Firmware 1.5.2.11 and Application Firmware 2.21.1.128. The admin account has a blank password." ;
