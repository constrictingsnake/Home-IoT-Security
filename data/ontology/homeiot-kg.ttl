  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2017-8221_cameras> ;
  hkg:cvssScore "7.5"^^xsd:decimal ;
  hkg:cvssVersion "3.0" ;
  hkg:hasWeakness <https://w3id.org/homeiot/kg/cwe/CWE-311> ;
  hkg:published "2017-04-25"^^xsd:date ;
  rdf:type hkg:Vulnerability ;
  rdfs:label "CVE-2017-8221" .

<https://w3id.org/homeiot/kg/cve/CVE-2017-8222>
  dcterms:description "Wireless IP Camera (P2P) WIFICAM devices have an \"Apple Production IOS Push Services\" private RSA key and certificate stored in /system/www/pem/ck.pem inside the firmware, which allows attackers to obtain sensitive information." ;
