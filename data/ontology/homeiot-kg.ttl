<https://w3id.org/homeiot/kg/cve/CVE-2017-5674>
  dcterms:description "A vulnerability in a custom-built GoAhead web server used on Foscam, Vstarcam, and multiple white-label IP camera models allows an attacker to craft a malformed HTTP (\"GET system.ini HTTP/1.1\\n\\n\" - note the lack of \"/\" in the path field of the request) request that will disclose the configuration file with the login password." ;
  hkg:affectsCategory hiot:cameras ;
  hkg:affectsProduct <https://w3id.org/homeiot/kg/product/embedthis/goahead> ;
  hkg:assignment <https://w3id.org/homeiot/kg/assignment/CVE-2017-5674_cameras> ;
  hkg:cvssScore "9.8"^^xsd:decimal ;
